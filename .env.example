# Demo works with no secrets. Copy to .env.local; never commit real values.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Use a password manager to generate a random 24+ character access code.
# This shared code protects a personal/portfolio demo, NOT a multi-user product.
APP_ACCESS_CODE=
# REQUIRED for live mode in production. Upstash Redis REST credentials:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global live-analysis limits shared across all users (not per user).
LIVE_REQUESTS_PER_MINUTE=1
LIVE_REQUESTS_PER_DAY=50
# Optional canonical URL, e.g. https://resume-lens.vercel.app (no trailing slash).
APP_ORIGIN=
